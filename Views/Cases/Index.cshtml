@model CaseListViewModel

@{
    ViewData["Title"] = "Cases";
    var canCreateCases = User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Examiner);
    var isAdmin = User.IsInRole(AppRoles.Administrator);
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Case management</p>
        <h1>Cases</h1>
    </div>
    @if (canCreateCases)
    {
        <a class="btn btn-primary" asp-action="Create">Create case</a>
    }
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info">@statusMessage</div>
}

<section class="content-panel role-split">
    <strong>Access split:</strong>
    Admin can edit, complete, cancel, and remove empty cases. Investigator can create cases, upload evidence, and download evidence. Reviewer can review records and verify hashes only. Reader can view records only.
</section>

<form class="filter-bar" method="get">
    <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Search case ID or title" />
    <select class="form-select" name="status">
        <option value="">All statuses</option>
        @foreach (var status in CaseListViewModel.Statuses)
        {
            <option value="@status" selected="@(Model.Status == status)">@status</option>
        }
    </select>
    <select class="form-select" name="priority">
        <option value="">All priorities</option>
        @foreach (var priority in CaseListViewModel.Priorities)
        {
            <option value="@priority" selected="@(Model.Priority == priority)">@priority</option>
        }
    </select>
    <button class="btn btn-dark" type="submit">Filter</button>
</form>

<section class="content-panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Case ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Assigned examiner</th>
                <th>Evidence</th>
                <th>Updated</th>
                @if (isAdmin)
                {
                    <th>Admin</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Cases)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@item.CaseId">@item.CaseNumber</a></td>
                    <td>@item.Title</td>
                    <td><span class="badge text-bg-light">@item.Status</span></td>
                    <td><span class="badge priority-@item.Priority.ToLowerInvariant()">@item.Priority</span></td>
                    <td>@(item.AssignedExaminerName ?? "Unassigned")</td>
                    <td>@item.EvidenceCount</td>
                    <td>@item.UpdatedAtUtc.ToString("u")</td>
                    @if (isAdmin)
                    {
                        <td><a asp-action="Edit" asp-route-id="@item.CaseId">Edit</a></td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
