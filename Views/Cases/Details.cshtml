@model CaseDetailsViewModel

@{
    ViewData["Title"] = Model.Case.CaseNumber;
    var isAdmin = User.IsInRole(AppRoles.Administrator);
    var canUploadEvidence = (User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Examiner)) && !Model.Case.IsTerminal;
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Case @Model.Case.CaseNumber</p>
        <h1>@Model.Case.Title</h1>
    </div>
    <div class="action-row">
        @if (isAdmin)
        {
            <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Case.CaseId">Edit case</a>
        }
        @if (canUploadEvidence)
        {
            <a class="btn btn-primary" asp-controller="Evidence" asp-action="Upload" asp-route-caseId="@Model.Case.CaseId">Upload evidence</a>
        }
    </div>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info">@statusMessage</div>
}

<section class="summary-grid">
    <div>
        <span>Status</span>
        <strong class="case-status case-status-@Model.Case.Status.ToLowerInvariant().Replace(" ", "-")">@Model.Case.Status</strong>
    </div>
    <div>
        <span>Priority</span>
        <strong>@Model.Case.Priority</strong>
    </div>
    <div>
        <span>Assigned examiner</span>
        <strong>@(Model.Case.AssignedExaminerName ?? "Unassigned")</strong>
    </div>
    <div>
        <span>Created UTC</span>
        <strong>@Model.Case.CreatedAtUtc.ToString("u")</strong>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Case.ResolutionReason))
{
    <section class="content-panel">
        <h2>Case Resolution</h2>
        <dl class="metadata-grid">
            <dt>Disposition</dt>
            <dd>@Model.Case.Status</dd>
            <dt>Reason</dt>
            <dd>@Model.Case.ResolutionReason</dd>
            <dt>Recorded by</dt>
            <dd>
                @(Model.Case.ClosedByName ?? "Unknown")
                @if (Model.Case.ClosedAtUtc is DateTime closedAt)
                {
                    <text> on @closedAt.ToString("u")</text>
                }
            </dd>
        </dl>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Model.Case.Description))
{
    <section class="content-panel">
        <h2>Case Notes</h2>
        <p>@Model.Case.Description</p>
    </section>
}

@if (isAdmin)
{
    <section class="content-panel admin-workflow">
        <div class="section-header">
            <h2>Admin Workflow</h2>
            <span class="access-badge">Administrator only</span>
        </div>
        <div class="admin-action-grid">
            <form class="form-stack" asp-action="Complete" asp-route-id="@Model.Case.CaseId" method="post">
                <h3>Complete case</h3>
                <textarea class="form-control" name="reason" rows="3" maxlength="2000" required placeholder="Completion explanation"></textarea>
                <button class="btn btn-primary" type="submit">Mark completed</button>
            </form>
            <form class="form-stack" asp-action="Cancel" asp-route-id="@Model.Case.CaseId" method="post">
                <h3>Cancel case</h3>
                <textarea class="form-control" name="reason" rows="3" maxlength="2000" required placeholder="Cancellation reason"></textarea>
                <button class="btn btn-outline-dark" type="submit">Cancel case</button>
            </form>
            <form class="form-stack danger-zone" asp-action="Delete" asp-route-id="@Model.Case.CaseId" method="post" onsubmit="return confirm('Remove this case? Cases with evidence are blocked and should be cancelled instead.');">
                <h3>Remove case</h3>
                <textarea class="form-control" name="reason" rows="3" maxlength="2000" required placeholder="Removal reason"></textarea>
                <button class="btn btn-danger" type="submit">Remove case</button>
            </form>
        </div>
    </section>
}

<section class="content-panel">
    <div class="section-header">
        <h2>Evidence</h2>
        @if (canUploadEvidence)
        {
            <a asp-controller="Evidence" asp-action="Upload" asp-route-caseId="@Model.Case.CaseId">Add item</a>
        }
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>File</th>
                <th>Type</th>
                <th>Size</th>
                <th>SHA-256</th>
                <th>Status</th>
                <th>Uploaded</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.EvidenceItems.Count == 0)
            {
                <tr>
                    <td colspan="6">No evidence has been added to this case.</td>
                </tr>
            }
            @foreach (var item in Model.EvidenceItems)
            {
                <tr>
                    <td><a asp-controller="Evidence" asp-action="Details" asp-route-id="@item.EvidenceId">@item.OriginalFileName</a></td>
                    <td>@item.EvidenceType</td>
                    <td>@item.FileSizeBytes.ToString("N0") bytes</td>
                    <td><code class="hash">@item.Sha256Hash</code></td>
                    <td><span class="badge verify-@item.VerificationStatus.ToLowerInvariant()">@item.VerificationStatus</span></td>
                    <td>@item.UploadedAtUtc.ToString("u")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
